<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>badgertech.putl.ideaplugle</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>AI Naming Assistant</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>PUTL</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        An intelligent AI-powered variable naming assistant. Supports multiple naming formats (camelCase, PascalCase, snake_case, etc.) and automatically generates standardized variable names based on descriptions.<br>
        <em>Uses OpenAI compatible API</em>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 配置面板 -->
        <projectConfigurable
                parentId="tools"
                instance="putl.ideaplugle.settings.NamingPluginConfigurable"
                id="putl.ideaplugle.settings"
                displayName="AI起名助手"/>
    </extensions>

    <!-- Actions -->
    <actions>
        <action id="putl.ideaplugle.GenerateNameAction"
                class="putl.ideaplugle.actions.GenerateNameAction"
                text="AI 即时命名"
                description="呼出居中命名框并直接将结果插入到光标位置">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EditorCopy"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift G"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift G"/>
        </action>
    </actions>
</idea-plugin>
